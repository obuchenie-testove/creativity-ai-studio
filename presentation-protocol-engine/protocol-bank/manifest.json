{
  "manifest_schema": "creativity.presentation-manifest/1.0",
  "project": "Creativity Presentation Protocol Engine",
  "version": "0.2.0",
  "release_status": "pilot",
  "owner": "Creativity LTD / Креативност ЕООД",
  "updated_on": "2026-11-15",
  "repository": "obuchenie-testove/creativity-ai-studio",
  "repository_prefix": "presentation-protocol-engine",
  "compatibility": "Read-access to public GitHub + support for Markdown instructions or Python 3.10+ helper; native slide export is host-dependent.",
  "execution_policy": {
    "git_snapshot": "Resolve the default branch to one full commit SHA and read every file at that SHA (raw.githubusercontent.com, or the jsDelivr mirror of the same SHA). Platforms that import the repository instead report bank_version and bank_digest.",
    "protocol_on_missing": "fail-closed; never substitute imagined contents",
    "required_protocols": [
      "core-governance",
      "core-quality",
      "core-output"
    ],
    "priority": [
      "system/platform safety",
      "explicit user constraints",
      "core protocols",
      "selected presentation",
      "selected visual",
      "optional thinking"
    ],
    "review_required": true,
    "default_presentation": "present-classic-business",
    "default_visual": "visual-clean",
    "selection_limits": {
      "presentation": 1,
      "visual": 1,
      "thinking": 1
    },
    "version_validation": "SHA-256 over UTF-8 raw bytes of each protocol JSON, then check id/version/schema.",
    "allowed_status": [
      "pilot",
      "approved"
    ],
    "selection_rule": "Host AI selects by meaning (title, when, tags) against the brief; the resolver scores bilingual tags as a deterministic fallback. Higher entry priority = more specific protocol and wins ties; remaining ties are reported as ambiguous.",
    "bank_identity": "bank_version = manifest.version; bank_digest = SHA-256 of manifest.json bytes (covers every protocol hash). Release tags bank-v<version> map a version to a commit.",
    "thinking_selection": "Optional. Explicit ID, or \"auto\" to select by tags; omitted otherwise."
  },
